{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "apps\\api\\mvnw.cmd",
        "-f",
        "apps\\api\\pom.xml",
        "-q",
        "spring-boot:run"
      ],
      "port": 8080
    },
    {
      "name": "kits",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "--directory",
        "design/kits"
      ],
      "port": 4321
    },
    {
      "name": "api-carga",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set FESTA_RATELIMIT_ENABLED=false&& apps\\api\\mvnw.cmd -f apps\\api\\pom.xml -q spring-boot:run"
      ],
      "port": 8080
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "apps/web",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}