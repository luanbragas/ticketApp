# Copie para .env.local e ajuste. Nunca commite .env.local.

# URL da API vista pelo navegador (CORS + cookies; ver ADR-001).
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL da API vista pelo servidor do Next (SSR). Em produção pode ser a rede interna.
API_INTERNAL_URL=http://localhost:8080

# Sentry (PLAN.md M0). Vazio = desligado. O DSN do navegador é público por natureza.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
